# Copie para .env.local e preencha. Nunca commite valores reais.

# URL pública do app (links do magic link, hosted auth e webhooks).
APP_URL=http://localhost:3000

# Supabase · Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Supabase · Project Settings → API Keys → Secret keys. Só o servidor usa, para
# criar o usuário de quem entra pela primeira vez com e-mail liberado (§4.1),
# sem ligar o cadastro público do Auth. Sem ela, só entra quem já tem usuário.
SUPABASE_SECRET_KEY=

# Domínios de e-mail que podem entrar pela primeira vez e ganhar uma organização
# própria (§4.1), separados por vírgula. Sem a variável, vale guessless.com.br;
# vazia, ninguém novo entra.
CADASTRO_DOMINIOS=guessless.com.br

# Supabase · Connect → Transaction pooler (porta 6543). Usada pelo servidor.
DATABASE_URL=postgresql://postgres.seu-projeto:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Opcional: CA do Supabase (PEM) para validar o TLS da conexão acima.
DATABASE_CA_CERT=

# Unipile · dashboard → Access Tokens. DSN no formato apiX.unipile.com:PORTA.
UNIPILE_DSN=api1.unipile.com:13111
UNIPILE_API_KEY=
# Segredo (16+ caracteres) que a Unipile manda no header Unipile-Auth dos webhooks.
UNIPILE_WEBHOOK_SECRET=

# Segredo (16+ caracteres) do tick do despachante (/api/cron/tick), em Authorization: Bearer.
CRON_SECRET=

# Alertas por e-mail (pausa de perfil, SLA). Sem as duas, os alertas ficam na fila.
RESEND_API_KEY=
# O domínio do remetente precisa estar verificado no Resend.
ALERTA_REMETENTE="SDR GuessLess <alertas@seu-dominio.com.br>"

# Agente de conversa (Claude). Sem a chave, as mensagens esperam o agente na fila.
ANTHROPIC_API_KEY=
# Os modelos ficam aqui; a troca é decidida pelo eval (§5 e §7.1).
IA_MODELO_CLASSIFICACAO=claude-haiku-4-5
IA_MODELO_RASCUNHO=claude-sonnet-5
# low | medium | high | xhigh | max
IA_ESFORCO_RASCUNHO=medium


# Eval de conversas (pnpm eval, §7.1). Usa a ANTHROPIC_API_KEY e os modelos acima.
# Juiz: o modelo que dá nota em promessa, reunião cedo e tom.
EVAL_MODELO_JUIZ=claude-opus-5-5
# low | medium | high | xhigh | max
EVAL_ESFORCO_JUIZ=medium
# Vezes que cada caso roda (1 a 5) e execuções em paralelo.
EVAL_REPETICOES=1
EVAL_CONCORRENCIA=4
# Filtros opcionais, separados por vírgula (rodada filtrada fica inconclusiva).
EVAL_PRACAS=
EVAL_CASOS=
# Calibração: pasta de uma rodada com o revisao.json preenchido. Não chama a API.
EVAL_REVISAO=

# Login desligado, só para teste: todo mundo entra como este operador, sem link
# de acesso. Deixe vazio para exigir login.
ACESSO_SEM_LOGIN_EMAIL=

# Módulos (§4.14). E-mails de quem é da GuessLess e liga e desliga módulos na
# tela Plataforma (/platform), separados por vírgula. Vazia, ninguém abre.
PLATAFORMA_ADMINS=
# Para onde leva o "Quero contratar" de Configurações > Plano (ex.: link do
# WhatsApp do comercial). Vazia, a tela diz para falar com a GuessLess.
COMERCIAL_URL=
