# Copie para .env.local e preencha. Nunca commite valores reais.

# URL pública do app (links do magic link, hosted auth e webhooks).
APP_URL=http://localhost:3000

# Supabase · Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Supabase · Connect → Transaction pooler (porta 6543). Usada pelo servidor.
DATABASE_URL=postgresql://postgres.seu-projeto:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Opcional: CA do Supabase (PEM) para validar o TLS da conexão acima.
DATABASE_CA_CERT=

# Unipile · dashboard → Access Tokens. DSN no formato apiX.unipile.com:PORTA.
UNIPILE_DSN=api1.unipile.com:13111
UNIPILE_API_KEY=
# Segredo (16+ caracteres) que a Unipile manda no header Unipile-Auth dos webhooks.
UNIPILE_WEBHOOK_SECRET=

# Segredo (16+ caracteres) do tick do despachante (/api/cron/tick), em Authorization: Bearer.
CRON_SECRET=

# Alertas por e-mail (pausa de perfil, SLA). Sem as duas, os alertas ficam na fila.
RESEND_API_KEY=
# O domínio do remetente precisa estar verificado no Resend.
ALERTA_REMETENTE="SDR GuessLess <alertas@seu-dominio.com.br>"
